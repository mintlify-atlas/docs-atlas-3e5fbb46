  "keyFeatures": [
    "Type-safe component variants with full TypeScript inference",
    "Compound variants for multi-condition class application",
    "Default variants with optional per-call overrides",
    "Framework-agnostic — works with React, Vue, Svelte, Astro, and more",
    "First-class Tailwind CSS support with IntelliSense integration",
    "Tiny bundle size (~1.6KB) built on top of clsx",
    "Extensible via defineConfig with onComplete hooks",
    "Supports class and className props for broad compatibility"
  ],
  "publicApiSurface": [
    "cva(config) => (props) => string",
    "cx(...inputs: ClassValue[]) => string",
    "compose(...components) => (props) => string",
    "defineConfig(options) => { cva, cx, compose }",
    "VariantProps<Component>",
    "ClassValue",
    "CXOptions",
    "CXReturn",
    "DefineConfigOptions"
  ]
